# Build artifacts
build/
build-dir/
repo/
*.flatpak
.flatpak-builder/

# Debian packaging build artifacts (dpkg-buildpackage)
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/*.debhelper
debian/*.substvars
debian/nightpanel/
*.deb
*.buildinfo
*.changes

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv*/
venv*/
*.egg-info/
.eggs/
dist/
# but keep the prepared third-party submission packages — these aren't
# build output, they're release-ready artifacts the maintainer reviews
# and uploads by hand (per the submission-carefulness convention).
!dist/extensions-gnome-org/
!dist/extensions-gnome-org/**

# Testing
.coverage
.pytest_cache/
htmlcov/
coverage.xml

# IDE
.idea/
.vscode/
*.swp
*.swo

# Linting
.ruff_cache/
.mypy_cache/

# AppImage build artifacts + downloaded tooling
*.AppImage
*.AppDir/
linuxdeploy-*

# Snap build artifacts (snapcraft writes to parts/stage/prime at build time)
parts/
stage/
prime/
*.snap

# Scratch/debug output
app_log*.txt
final_check.txt

# Misc
*.log
.DS_Store
