{
  "manifest_version": 2,
  "name": "nightpanel bridge",
  "version": "2.2",
  "description": "nightpanel bridge — Inter Light text, amber links, NP green, desaturated images",
  "browser_specific_settings": {
    "gecko": {
      "id": "nightpanel-bridge@nightpanel",
      "strict_min_version": "78.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "notifications",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  }
}
