# Maintainer: Greg Felice <greg@gregfelice.com>
pkgname=nightpanel
pkgver=0.2.1
pkgrel=1
pkgdesc="Visual keyboard configuration + system-wide dark-mode orchestrator for GNOME"
arch=('any')
url="https://github.com/gregfelice/nightpanel"
license=('GPL-3.0-or-later')
depends=(
    'gtk4>=4.10'
    'libadwaita>=1.4'
    'python'
    'python-gobject'
    'python-pydantic'
    'python-tomli-w'
    'dconf'
)
makedepends=(
    'meson'
    'ninja'
    'python-build'
    'python-installer'
    'python-wheel'
)
optdepends=(
    'gnome-shell-extension-tiling-assistant: Tiling Assistant shortcut support'
)
provides=('dailydriver')
conflicts=('dailydriver')
replaces=('dailydriver')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/gregfelice/nightpanel/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')  # TODO: replace with real sha256 after v0.2.1 GH Release tarball lands

build() {
    cd "${pkgname}-${pkgver}"
    arch-meson . build
    meson compile -C build
}

package() {
    cd "${pkgname}-${pkgver}"
    meson install -C build --destdir "$pkgdir"
}
