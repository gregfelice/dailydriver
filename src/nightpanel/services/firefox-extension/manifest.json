{
  "manifest_version": 2,
  "name": "nightpanel bridge",
  "version": "1.6",
  "description": "nightpanel bridge — dims pages when nightpanel is active",
  "browser_specific_settings": {
    "gecko": {
      "id": "nightpanel-bridge@nightpanel",
      "strict_min_version": "78.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "notifications",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  }
}
